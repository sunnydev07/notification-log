    <string name="access_needed_title">Notification access needed</string>
    <!-- Prominent-disclosure copy (Play User Data policy): must state WHAT is
         read, WHERE it goes, and that it never leaves the device BEFORE the
         user is sent to grant access. Wording mirrors the privacy policy. -->
    <string name="access_needed_body">To save your notification history, this app reads
incoming notifications — their title, text, and sending app — and stores them on
this device only. Nothing is uploaded, shared, or synced. You can review or delete
everything anytime.</string>
    <string name="grant_access_button">Open Notification Access settings</string>

