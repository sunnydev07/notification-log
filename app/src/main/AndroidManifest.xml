<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Intentionally NO permissions beyond the two declarations below.
      This app is 100% offline; it must never request INTERNET.

      REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (phase 4): a "normal" permission that
      lets us show the system dialog asking to be exempted from Doze/battery
      optimization. Without an exemption, OEM battery managers may silently kill
      our listener service and history capture stops with no error shown anywhere.
      The dialog itself is user-approved; this permission only unlocks it.
      (Play Store restricts this permission's use, but this app is sideloaded and
      offline-only, so that policy does not apply.)
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      allowBackup="false" (phase 5): Android auto-backup would upload the Room
      database — i.e. captured notification content — to the user's Google
      Drive, which directly violates the app's "nothing ever leaves your
      phone" promise. The cost: history is lost on reinstall/device switch.
      That is the correct trade-off for this app; revisit only with explicit
      local-export functionality, never silent cloud sync.
    -->
    <application
        android:name=".NotificationLogApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationLog">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Notification listener. Key points (learning notes):

          - BIND_NOTIFICATION_LISTENER_SERVICE is a permission the SYSTEM holds,
            not our app. Requiring it here means only the OS can bind to this
            service — third-party apps cannot talk to it.

          - The intent-filter action is how Settings discovers us and lists this
            app under "Notification access". Without it, the toggle never shows up.

          - exported="true" is required so the system (a separate process) can
            resolve and bind via that implicit intent-filter; the bind permission
            above is what keeps everyone else out.

          - After the user flips the toggle in Settings, the system binds this
            service automatically. We never start it ourselves, and there is no
            runtime permission dialog for notification access.
        -->
        <service
            android:name=".service.NotificationCaptureService"
            android:exported="true"
            android:label="@string/listener_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
